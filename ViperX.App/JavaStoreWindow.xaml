<Window x:Class="ViperX.App.JavaStoreWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Java Store • ViperX" Height="650" Width="900" MinHeight="560" MinWidth="760"
        WindowStartupLocation="CenterOwner" Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI">
  <Grid Margin="26">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Grid.Row="0" Margin="0,0,0,22">
      <StackPanel>
        <TextBlock Text="RUNTIME MANAGEMENT" Foreground="{StaticResource AccentBrush}" FontSize="10" FontWeight="Bold"/>
        <TextBlock Text="Java Store" FontSize="30" FontWeight="ExtraBold" Margin="0,4,0,0"/>
        <TextBlock Text="Install portable Java runtimes without leaving ViperX." Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,4,0,0"/>
      </StackPanel>
      <Border DockPanel.Dock="Right" Background="#14271B" BorderBrush="#31523B" BorderThickness="1" CornerRadius="12" Padding="14,9" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Fill="{StaticResource AccentBrush}" Margin="0,0,8,0"/><TextBlock Text="ViperX managed runtimes" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
      </Border>
    </DockPanel>
    <Border Grid.Row="1" Background="#14251B" BorderBrush="#31523B" BorderThickness="1" CornerRadius="14" Padding="18" Margin="0,0,0,18">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="INSTALL A RUNTIME" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
          <TextBlock Text="Choose a Java version" FontSize="18" FontWeight="Bold" Margin="0,6,0,4"/>
          <TextBlock Text="Downloads an Eclipse Temurin JRE into your local ViperX runtime folder." Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap"/>
          <ComboBox x:Name="JavaVersionSelector" DisplayMemberPath="DisplayName" SelectedValuePath="MajorVersion" MinWidth="360" Padding="8,7" Margin="0,14,0,0"/>
        </StackPanel>
        <Button Grid.Column="1" x:Name="InstallButton" Content="↓   INSTALL JAVA" Background="{StaticResource AccentBrush}" Foreground="#071009" BorderBrush="{StaticResource AccentBrush}" FontWeight="Bold" Padding="20,13" VerticalAlignment="Bottom" Margin="16,0,0,0" Click="Install_Click"/>
      </Grid>
    </Border>
    <Grid Grid.Row="2">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <DockPanel Grid.Row="0" Margin="0,0,0,12">
        <TextBlock Text="INSTALLED RUNTIMES" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"/>
        <Button DockPanel.Dock="Right" Content="↻  Refresh" Padding="10,5" Click="Refresh_Click"/>
      </DockPanel>
      <Border Grid.Row="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="12">
        <ListView x:Name="RuntimeList" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}">
          <ListView.View><GridView>
            <GridViewColumn Header="VERSION" Width="125" DisplayMemberBinding="{Binding Version}"/>
            <GridViewColumn Header="JAVA" Width="80" DisplayMemberBinding="{Binding MajorVersion}"/>
            <GridViewColumn Header="EXECUTABLE" Width="430" DisplayMemberBinding="{Binding ExecutablePath}"/>
          </GridView></ListView.View>
        </ListView>
      </Border>
    </Grid>
    <StackPanel Grid.Row="3" Margin="0,16,0,0">
      <ProgressBar x:Name="InstallProgress" Height="5" Minimum="0" Maximum="100" Value="0" Visibility="Collapsed"/>
      <TextBlock x:Name="StatusText" Text="Ready. Java versions installed here can be selected automatically when you launch Minecraft." Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0"/>
      <DockPanel Margin="0,12,0,0"><TextBlock Text="Downloads supplied by Eclipse Adoptium (Temurin)." Foreground="#647168" FontSize="10" VerticalAlignment="Center"/><Button DockPanel.Dock="Right" Content="Done" Padding="18,8" Click="Close_Click"/></DockPanel>
    </StackPanel>
  </Grid>
</Window>