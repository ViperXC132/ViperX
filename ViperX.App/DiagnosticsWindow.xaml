<Window x:Class="ViperX.App.DiagnosticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ViperX — Diagnostics" Height="700" Width="1000" MinHeight="520" MinWidth="760"
        WindowStartupLocation="CenterOwner" Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="TROUBLESHOOTING" Foreground="{StaticResource AccentBrush}" FontSize="10" FontWeight="Bold"/>
            <TextBlock Text="Game diagnostics" FontSize="28" FontWeight="Bold" Margin="0,5"/>
            <TextBlock Text="Read recent Minecraft logs and crash reports from an installed game directory. Files are read locally and are not uploaded." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
            <DockPanel Margin="0,14,0,0">
                <ComboBox x:Name="InstallationCombo" DisplayMemberPath="Name" MinWidth="280" SelectionChanged="InstallationCombo_SelectionChanged" DockPanel.Dock="Left"/>
                <Button Content="Refresh files" Click="Refresh_Click" Margin="10,0,0,0"/>
                <Button Content="Open game folder" Click="OpenFolder_Click" Margin="8,0,0,0"/>
            </DockPanel>
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,0,12,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="LOGS &amp; CRASH REPORTS" Foreground="{StaticResource AccentBrush}" FontSize="10" FontWeight="Bold" Margin="4,4,4,10"/>
                    <ListBox x:Name="FilesList" DisplayMemberPath="DisplayName" SelectionChanged="FilesList_SelectionChanged" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}"/>
                </DockPanel>
            </Border>
            <Border Grid.Column="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="FILE CONTENTS" Foreground="{StaticResource AccentBrush}" FontSize="10" FontWeight="Bold" Margin="4,4,4,10"/>
                    <TextBox x:Name="ContentBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             FontFamily="Consolas" FontSize="11" Background="#0B100D" Foreground="#D5E2D8"
                             BorderThickness="0" Padding="10"/>
                </DockPanel>
            </Border>
        </Grid>
        <DockPanel Grid.Row="2" Margin="0,14,0,0">
            <TextBlock x:Name="StatusText" Text="Choose an installation to inspect its logs." Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center"/>
            <Button DockPanel.Dock="Right" Content="Close" Click="Close_Click" Padding="18,9"/>
        </DockPanel>
    </Grid>
</Window>