<Window x:Class="ViperX.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ViperX — Settings" Height="620" Width="760"
        MinHeight="540" MinWidth="640" WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI">
    <Grid Margin="28">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="PREFERENCES" Foreground="{StaticResource AccentBrush}" FontSize="10" FontWeight="Bold"/>
            <TextBlock Text="Launcher settings" FontSize="28" FontWeight="Bold" Margin="0,5"/>
            <TextBlock Text="Settings are saved locally in your ViperX application data folder." Foreground="{StaticResource MutedBrush}"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Java executable (optional)" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <DockPanel Margin="0,0,0,16">
                    <Button DockPanel.Dock="Right" Content="Browse…" Click="BrowseJava_Click" Margin="8,0,0,0"/>
                    <TextBox x:Name="JavaPathBox" VerticalContentAlignment="Center"/>
                </DockPanel>
                <Button Content="Detect installed Java" HorizontalAlignment="Left" Click="DetectJava_Click" Margin="0,0,0,18"/>
                <TextBlock Text="Default memory (MB)" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <TextBox x:Name="MemoryBox" Width="180" HorizontalAlignment="Left" Margin="0,0,0,16"/>
                <TextBlock Text="Default game directory (optional)" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <DockPanel Margin="0,0,0,16">
                    <Button DockPanel.Dock="Right" Content="Browse…" Click="BrowseGameDirectory_Click" Margin="8,0,0,0"/>
                    <TextBox x:Name="GameDirectoryBox" VerticalContentAlignment="Center"/>
                </DockPanel>
                <TextBlock Text="Window width" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <TextBox x:Name="WidthBox" Width="180" HorizontalAlignment="Left" Margin="0,0,0,16"/>
                <TextBlock Text="Window height" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <TextBox x:Name="HeightBox" Width="180" HorizontalAlignment="Left" Margin="0,0,0,16"/>
                <CheckBox x:Name="CloseOnLaunchBox" Content="Close launcher after starting Minecraft" Margin="0,0,0,10"/>
                <CheckBox x:Name="KeepOpenBox" Content="Keep launcher open after Minecraft exits" Margin="0,0,0,12"/>
                <TextBlock x:Name="StatusText" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
            </StackPanel>
        </ScrollViewer>
        <DockPanel Grid.Row="2" Margin="0,16,0,0">
            <Button DockPanel.Dock="Right" Content="Save settings" Click="Save_Click" Background="{StaticResource AccentBrush}" Foreground="#061009" FontWeight="Bold" Padding="18,10"/>
            <Button DockPanel.Dock="Right" Content="Cancel" Click="Close_Click" Margin="0,0,8,0" Padding="18,10"/>
        </DockPanel>
    </Grid>
</Window>