<Window x:Class="ViperX.App.AccountsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ViperX — Accounts" Height="560" Width="720"
        MinHeight="480" MinWidth="600" WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI">
    <Grid Margin="28">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="PLAYER IDENTITY" Foreground="{StaticResource AccentBrush}" FontSize="10" FontWeight="Bold"/>
            <TextBlock Text="Microsoft account" FontSize="28" FontWeight="Bold" Margin="0,5"/>
            <TextBlock Text="Sign in through Microsoft's device-code flow. ViperX never asks for your Microsoft password." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
        </StackPanel>
        <Border Grid.Row="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Microsoft public-client application ID" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <TextBox x:Name="ClientIdBox" ToolTip="Enter your registered Microsoft Entra public-client application ID"/>
                <TextBlock Text="Requires an application registration configured for public-client/device-code authentication and the XboxLive.signin scope. Do not enter a client secret." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,8,0,0"/>
            </StackPanel>
        </Border>
        <Border Grid.Row="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="18">
            <StackPanel>
                <TextBlock Text="CURRENT SESSION" Foreground="{StaticResource AccentBrush}" FontSize="10" FontWeight="Bold"/>
                <TextBlock x:Name="AccountNameText" Text="Not signed in" FontSize="20" FontWeight="Bold" Margin="0,8,0,4"/>
                <TextBlock x:Name="AccountDetailText" Text="Your Minecraft session will be held in memory only." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                <TextBlock x:Name="DeviceCodeText" Text="" FontSize="24" FontWeight="Bold" Margin="0,18,0,6"/>
                <TextBlock x:Name="StatusText" Text="Ready." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,14"/>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="SignInButton" Content="Sign in with Microsoft" Click="SignIn_Click" Background="{StaticResource AccentBrush}" Foreground="#061009" FontWeight="Bold"/>
                    <Button Content="Sign out" Click="SignOut_Click" Margin="10,0,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>
        <DockPanel Grid.Row="3" Margin="0,16,0,0">
            <TextBlock Text="Credentials are not saved to disk in this build." Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center"/>
            <Button DockPanel.Dock="Right" Content="Close" Click="Close_Click" Padding="18,9"/>
        </DockPanel>
    </Grid>
</Window>