<Window x:Class="ViperX.App.AccountsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ViperX — Accounts" Height="790" Width="760" MinHeight="650" MinWidth="620"
        WindowStartupLocation="CenterOwner" Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="26">
        <TextBlock Text="PLAYER IDENTITY" Foreground="{StaticResource AccentBrush}" FontSize="10" FontWeight="Bold"/>
        <TextBlock Text="Accounts" FontSize="30" FontWeight="Bold" Margin="0,4,0,3"/>
        <TextBlock Text="Choose the identity you want ViperX to launch with." Foreground="{StaticResource MutedBrush}" Margin="0,0,0,18"/>
        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,12">
          <StackPanel>
            <TextBlock Text="CURRENT ACCOUNT" Foreground="{StaticResource AccentBrush}" FontSize="10" FontWeight="Bold"/>
            <TextBlock x:Name="AccountNameText" Text="Not signed in" FontSize="20" FontWeight="Bold" Margin="0,7,0,3"/>
            <TextBlock x:Name="AccountDetailText" Text="Select an account type below." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
            <TextBlock x:Name="StatusText" Text="Ready." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,10,0,0"/>
          </StackPanel>
        </Border>
        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,12">
          <StackPanel>
            <TextBlock Text="MICROSOFT JAVA EDITION" FontWeight="Bold" Margin="0,0,0,8"/>
            <TextBox x:Name="ClientIdBox" ToolTip="Microsoft public-client application ID (GUID)" Margin="0,0,0,8"/>
            <Button x:Name="SignInButton" Content="Sign in with Microsoft" Click="SignIn_Click" Background="{StaticResource AccentBrush}" Foreground="#061009" FontWeight="Bold" HorizontalAlignment="Left"/>
            <TextBlock x:Name="DeviceCodeText" FontSize="18" FontWeight="Bold" Margin="0,8,0,0"/>
            <TextBlock Text="Uses Microsoft's device-code flow. Never enter your Microsoft password into ViperX." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="11" Margin="0,6,0,0"/>
          </StackPanel>
        </Border>
        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,12">
          <StackPanel>
            <TextBlock Text="OFFLINE ACCOUNT" FontWeight="Bold" Margin="0,0,0,8"/>
            <TextBox x:Name="OfflineNameBox" ToolTip="Player name (3–16 letters, numbers or underscore)" Margin="0,0,0,8"/>
            <Button Content="Use offline account" Click="Offline_Click" HorizontalAlignment="Left"/>
            <TextBlock Text="Only works on single-player and servers that permit offline-mode identities; it does not authenticate you to premium online-mode servers." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="11" Margin="0,8,0,0"/>
          </StackPanel>
        </Border>
        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,12">
          <StackPanel>
            <TextBlock Text="YGGDRASIL ACCOUNTS" FontWeight="Bold" Margin="0,0,0,8"/>
            <TextBlock Text="Provider preset" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
            <ComboBox x:Name="ProviderBox" SelectedIndex="0" Margin="0,4,0,8" SelectionChanged="Provider_SelectionChanged">
              <ComboBoxItem Content="LittleSkin" Tag="LittleSkin"/>
              <ComboBoxItem Content="Ely.by" Tag="Ely.by"/>
              <ComboBoxItem Content="Local / custom Yggdrasil" Tag="Custom"/>
            </ComboBox>
            <TextBlock Text="Yggdrasil API base URL" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
            <TextBox x:Name="ServerUrlBox" Text="https://littleskin.cn/api/yggdrasil" Margin="0,4,0,8"/>
            <TextBox x:Name="YggdrasilUsernameBox" ToolTip="Username or email" Margin="0,0,0,8"/>
            <PasswordBox x:Name="YggdrasilPasswordBox" Margin="0,0,0,8"/>
            <Button x:Name="YggdrasilSignInButton" Content="Sign in to selected provider" Click="YggdrasilSignIn_Click" HorizontalAlignment="Left" Background="{StaticResource AccentBrush}" Foreground="#061009" FontWeight="Bold"/>
            <TextBlock Text="For a local server, use its documented API base URL (for example http://localhost:port/ only when hosted on this PC). Third-party accounts use their provider's real authentication service." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="11" Margin="0,8,0,0"/>
          </StackPanel>
        </Border>
        <DockPanel Margin="0,4,0,0">
          <Button Content="Sign out" Click="SignOut_Click" HorizontalAlignment="Left"/>
          <Button DockPanel.Dock="Right" Content="Close" Click="Close_Click" Padding="18,9"/>
        </DockPanel>
    </StackPanel>
    </ScrollViewer>
</Window>