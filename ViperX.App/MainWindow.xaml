<Window x:Class="ViperX.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="ViperX" Height="800" Width="1280" MinHeight="680" MinWidth="1000" WindowStartupLocation="CenterScreen" Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI" WindowStyle="SingleBorderWindow">
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="224"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Grid.Column="0" Background="#0D120F" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
      <DockPanel Margin="18">
        <StackPanel DockPanel.Dock="Top">
          <StackPanel Orientation="Horizontal" Margin="4,10,0,34">
            <Border Width="36" Height="36" CornerRadius="11" Background="{StaticResource AccentBrush}"><TextBlock Text="V" Foreground="#071009" FontSize="24" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center"><TextBlock Text="VIPERX" FontSize="20" FontWeight="ExtraBold"/><TextBlock Text="MINECRAFT LAUNCHER" FontSize="9" Foreground="{StaticResource MutedBrush}" FontWeight="SemiBold"/></StackPanel>
          </StackPanel>
          <TextBlock Text="WORKSPACE" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold" Margin="8,0,0,10"/>
          <Button Content="⌂    Home" HorizontalContentAlignment="Left" Background="#1B2A20" BorderBrush="#315B3D" Margin="0,0,0,6" Click="Home_Click"/>
          <Button Content="▶    Play" HorizontalContentAlignment="Left" Margin="0,0,0,6" Click="Play_Click"/>
          <Button Content="▦    Versions" HorizontalContentAlignment="Left" Margin="0,0,0,6" Click="Versions_Click"/>
          <Button Content="◇    Mods &amp; Modpacks" HorizontalContentAlignment="Left" Margin="0,0,0,6" Click="Mods_Click"/>
          <Button Content="♙    Accounts" HorizontalContentAlignment="Left" Margin="0,0,0,6" Click="Accounts_Click"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,8">
          <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,0,0,16"/>
          <Button Content="▤    Diagnostics" HorizontalContentAlignment="Left" Margin="0,0,0,6" Click="Diagnostics_Click"/>
          <Button Content="⚙    Settings" HorizontalContentAlignment="Left" Click="Settings_Click"/>
          <TextBlock Text="VIPERX • EARLY BUILD" Foreground="#647168" FontSize="9" Margin="8,18,0,0"/>
        </StackPanel>
      </DockPanel>
    </Border>
    <Grid Grid.Column="1" Margin="30">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <DockPanel Grid.Row="0" Margin="0,0,0,26">
        <StackPanel><TextBlock x:Name="PageEyebrow" Text="YOUR NEXT ADVENTURE" Foreground="{StaticResource AccentBrush}" FontSize="10" FontWeight="Bold" /><TextBlock x:Name="PageTitle" Text="Welcome back." FontSize="29" FontWeight="Bold" Margin="0,4,0,0"/></StackPanel>
        <Border DockPanel.Dock="Right" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="12,8" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Fill="{StaticResource AccentBrush}" Margin="0,0,8,0"/><TextBlock Text="Launcher ready" Foreground="{StaticResource MutedBrush}" FontSize="12" VerticalAlignment="Center"/></StackPanel></Border>
      </DockPanel>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <Border CornerRadius="18" BorderBrush="#31523B" BorderThickness="1" ClipToBounds="True">
            <Grid MinHeight="290">
              <Grid.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#1A3825" Offset="0"/><GradientStop Color="#14251B" Offset="0.52"/><GradientStop Color="#101713" Offset="1"/></LinearGradientBrush></Grid.Background>
              <Ellipse Width="340" Height="340" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,40,0" Stroke="#284B32" StrokeThickness="1" Opacity="0.8"/>
              <Ellipse Width="250" Height="250" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,85,0" Stroke="#35623F" StrokeThickness="1" Opacity="0.8"/>
              <TextBlock Text="X" FontSize="190" FontWeight="Black" Foreground="#183A25" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,110,0"/>
              <StackPanel VerticalAlignment="Center" Margin="34,28" MaxWidth="560" HorizontalAlignment="Left">
                <Border Background="#233D2B" CornerRadius="5" Padding="9,5" HorizontalAlignment="Left"><TextBlock Text="✦  BUILT FOR YOUR NEXT WORLD" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/></Border>
                <TextBlock Text="Your world.&#10;Your rules." FontSize="42" FontWeight="ExtraBold" LineHeight="46" Margin="0,16,0,8"/>
                <TextBlock Text="A faster way to get into Minecraft. Pick an installation, manage your setup, and launch your next adventure." Foreground="#B7C8BC" FontSize="13" TextWrapping="Wrap" MaxWidth="460" LineHeight="21"/>
                <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                  <Button Content="▶   PLAY MINECRAFT" Background="{StaticResource AccentBrush}" Foreground="#061009" BorderBrush="{StaticResource AccentBrush}" FontWeight="Bold" Padding="22,13" Click="Play_Click"/>
                  <Button Content="Manage installations  →" Margin="10,0,0,0" Padding="16,13" Click="Versions_Click"/>
                </StackPanel>
              </StackPanel>
            </Grid>
          </Border>
          <TextBlock Text="QUICK ACCESS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="2,25,0,12"/>
          <UniformGrid Columns="3">
            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="17" Margin="0,0,10,0"><StackPanel><TextBlock Text="▦" FontSize="23" Foreground="{StaticResource AccentBrush}"/><TextBlock Text="Installations" FontSize="15" FontWeight="SemiBold" Margin="0,12,0,4"/><TextBlock Text="Choose and configure game versions." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="11"/><Button Content="Open versions →" HorizontalAlignment="Left" Margin="0,14,0,0" Click="Versions_Click"/></StackPanel></Border>
            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="17" Margin="0,0,10,0"><StackPanel><TextBlock Text="◇" FontSize="23" Foreground="{StaticResource AccentBrush}"/><TextBlock Text="Mods &amp; modpacks" FontSize="15" FontWeight="SemiBold" Margin="0,12,0,4"/><TextBlock Text="Organize your modded Minecraft setup." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="11"/><Button Content="Manage mods →" HorizontalAlignment="Left" Margin="0,14,0,0" Click="Mods_Click"/></StackPanel></Border>
            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="17"><StackPanel><TextBlock Text="♙" FontSize="23" Foreground="{StaticResource AccentBrush}"/><TextBlock Text="Accounts" FontSize="15" FontWeight="SemiBold" Margin="0,12,0,4"/><TextBlock Text="Manage your launcher profiles." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="11"/><Button Content="View accounts →" HorizontalAlignment="Left" Margin="0,14,0,0" Click="Accounts_Click"/></StackPanel></Border>
          </UniformGrid>
          <Border Background="#111713" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,14,0,0"><DockPanel><TextBlock Text="ⓘ" Foreground="{StaticResource AccentBrush}" FontSize="18" Margin="0,0,12,0"/><StackPanel><TextBlock Text="First launch setup" FontWeight="SemiBold"/><TextBlock Text="ViperX UI is ready. Minecraft installation, account authentication, and loader integration are the next build stages." Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel></DockPanel></Border>
        </StackPanel>
      </ScrollViewer>
      <DockPanel Grid.Row="2" Margin="0,18,0,0"><TextBlock Text="VIPERX  /  EARLY ACCESS" Foreground="#637168" FontSize="10" VerticalAlignment="Center"/><TextBlock Text="Crafted for the game." Foreground="#637168" FontSize="10" DockPanel.Dock="Right" VerticalAlignment="Center"/></DockPanel>
    </Grid>
  </Grid>
</Window>
