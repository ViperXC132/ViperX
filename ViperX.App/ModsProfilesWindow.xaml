<Window x:Class="ViperX.App.ModsProfilesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ViperX — Mods &amp; Profiles" Height="650" Width="900"
        MinHeight="540" MinWidth="720" WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI">
    <Grid Margin="26">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="CUSTOMIZE" Foreground="{StaticResource AccentBrush}" FontSize="10" FontWeight="Bold"/>
            <TextBlock Text="Profiles &amp; mods" FontSize="28" FontWeight="Bold" Margin="0,5"/>
            <TextBlock Text="Manage named profiles and inspect the selected installation's mods folder. Loader installation is not included yet." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,12,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                        <TextBox x:Name="ProfileNameBox" ToolTip="New profile name" Margin="0,0,0,8"/>
                        <ComboBox x:Name="InstallationCombo" DisplayMemberPath="Name" Margin="0,0,0,8"/>
                        <Button Content="Create profile" Click="CreateProfile_Click" Background="{StaticResource AccentBrush}" Foreground="#061009" FontWeight="Bold" Margin="0,0,0,6"/>
                        <Button Content="Remove selected profile" Click="RemoveProfile_Click"/>
                    </StackPanel>
                    <ListBox x:Name="ProfilesList" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}" SelectionChanged="ProfilesList_SelectionChanged" DisplayMemberPath="Name"/>
                </DockPanel>
            </Border>
            <Border Grid.Column="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="18">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="MOD FILES" Foreground="{StaticResource AccentBrush}" FontSize="10" FontWeight="Bold"/>
                        <TextBlock x:Name="SelectedProfileText" Text="Select a profile" FontSize="20" FontWeight="Bold" Margin="0,7,0,4"/>
                        <TextBlock x:Name="ModFolderText" Text="Select an installation to inspect its mods folder." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Button Content="Open mods folder" Click="OpenModsFolder_Click" Margin="0,0,8,0"/>
                            <Button Content="Refresh list" Click="RefreshMods_Click"/>
                        </StackPanel>
                    </StackPanel>
                    <ListBox x:Name="ModsList" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}"/>
                </DockPanel>
            </Border>
        </Grid>
        <DockPanel Grid.Row="2" Margin="0,14,0,0">
            <TextBlock x:Name="StatusText" Text="Ready." Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center"/>
            <Button DockPanel.Dock="Right" Content="Close" Click="Close_Click" Padding="18,9"/>
        </DockPanel>
    </Grid>
</Window>